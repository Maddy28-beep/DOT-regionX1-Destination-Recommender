--- a/public/css/admin-workspace.css
+++ b/public/css/admin-workspace.css
@@ -271,3 +271,82 @@
     body.admin-workspace .admin-main { padding: 0; }
     body.admin-workspace .adm-card { break-inside: avoid; }
 }
+
+/* Interaction refinement: quiet row tools, actionable metrics, and separate filter levels. */
+body.admin-workspace .adm-kpi--link {
+    display: grid; grid-template-columns: minmax(0, 1fr) 14px; grid-template-rows: auto auto 1fr;
+    align-items: start; gap: 10px 6px; min-height: 138px; padding: 17px 18px;
+    text-decoration: none; color: var(--ink); transition: border-color .12s ease, background-color .12s ease;
+}
+body.admin-workspace .adm-kpi--link:hover { border-color: #9bb9ad; background: #fcfefd; }
+body.admin-workspace .adm-kpi--link .adm-kpi__lab { margin: 0; color: #56676f; font-size: 12px; font-weight: 500; }
+body.admin-workspace .adm-kpi--link .adm-kpi__val { grid-column: 1 / -1; font-size: 29px; color: #253b33; }
+body.admin-workspace .adm-kpi__go { width: 14px; height: 14px; margin-top: 2px; color: #8b9993; stroke-width: 1.7; }
+body.admin-workspace .adm-kpi__foot { grid-column: 1 / -1; align-self: end; min-height: 28px; font-size: 11px; color: #65717c; line-height: 1.4; }
+body.admin-workspace .stat-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr)); gap: 12px; margin-bottom: 22px; }
+body.admin-workspace .stat-card--link { display: block; text-decoration: none; color: inherit; }
+body.admin-workspace .stat-card--link:hover { border-color: #9bb9ad; background: #fcfefd; }
+body.admin-workspace .stat-card--link:focus-visible { outline: 2px solid #397ea1; outline-offset: 3px; }
+body.admin-workspace .adm-listing-tabs { display: flex; gap: 22px; margin: 0 0 18px; border-bottom: 1px solid var(--border); overflow-x: auto; scrollbar-width: thin; }
+body.admin-workspace .adm-listing-tabs a { flex: none; padding: 0 0 11px; border-bottom: 2px solid transparent; color: #67767f; font-size: 13px; font-weight: 500; text-decoration: none; white-space: nowrap; }
+body.admin-workspace .adm-listing-tabs a:hover { color: var(--primary); }
+body.admin-workspace .adm-listing-tabs a.on { border-bottom-color: var(--primary); color: var(--primary); font-weight: 600; }
+body.admin-workspace .adm-listing-tools { justify-content: space-between; align-items: center; padding-bottom: 16px; }
+body.admin-workspace .adm-listing-tools .adm-listing-search { flex: 0 1 340px; width: auto; margin: 0; }
+body.admin-workspace .adm-listing-search input { padding-right: 40px; }
+body.admin-workspace .adm-listing-search .adm-listing-search__submit { position: absolute; inset: 3px 3px 3px auto; width: 30px; min-width: 30px; height: 30px; border: 0; background: transparent; }
+body.admin-workspace .adm-listing-search__submit svg { position: static; margin: 0; width: 14px; height: 14px; }
+body.admin-workspace .adm-col-select { width: 42px; }
+body.admin-workspace .adm-col-name { width: 35%; }
+body.admin-workspace .adm-col-actions { width: 92px; }
+body.admin-workspace .adm-table .col-check { padding-left: 16px; padding-right: 8px; }
+body.admin-workspace input[type=checkbox] { width: 15px; height: 15px; margin: 0; accent-color: var(--primary); vertical-align: middle; }
+body.admin-workspace .adm-actions { gap: 3px; align-items: center; }
+body.admin-workspace .adm-actions .adm-icon-btn { width: 32px; height: 32px; min-width: 32px; border-color: transparent; background: transparent; color: #66747b; }
+body.admin-workspace .adm-actions .adm-icon-btn:hover { border-color: #e0e6ea; background: #f3f6f7; color: #294b3e; }
+body.admin-workspace .adm-actions [title^="Archive"]:hover { color: #a0463f; background: #fff1ef; border-color: #f0d3ce; }
+body.admin-workspace .adm-actions .adm-icon-btn svg { width: 15px; height: 15px; }
+body.admin-workspace .btn[disabled], body.admin-workspace .adm-icon-btn[disabled] { opacity: .5; cursor: not-allowed; filter: none; }
+body.admin-workspace .chip-row { display: flex; align-items: center; gap: 5px; flex-wrap: wrap; }
+body.admin-workspace .chip { border: 1px solid transparent; border-radius: 5px; padding: 6px 10px; font-size: 12px; color: #64717a; background: transparent; }
+body.admin-workspace .chip.active { color: #146b55; background: #eaf4ef; border-color: #d5e7dd; }
+body.admin-workspace .table-scroll { width: 100%; min-width: 0; overflow-x: auto; }
+body.admin-workspace .adm-origin .adm-toolbar { display: grid; grid-template-columns: minmax(220px, 1.8fr) minmax(135px, 1fr) minmax(135px, 1fr) auto auto auto; align-items: end; gap: 12px; }
+body.admin-workspace .adm-origin .adm-toolbar label { display: grid; gap: 6px; font-size: 12px; }
+body.admin-workspace .adm-origin .adm-toolbar input, body.admin-workspace .adm-origin .adm-toolbar select { width: 100%; }
+body.admin-workspace .site-dropdown-trigger { min-width: 0; min-height: 36px; border: 1px solid #dbe1e7; border-radius: 6px; background: #fff; font-size: 13px; box-shadow: none; }
+body.admin-workspace .adm-origin .site-dropdown { min-width: 0; max-width: 100%; }
+body.admin-workspace .adm-origin .adm-toolbar__note { grid-column: 1 / -1; font-size: 11px; }
+body.admin-workspace .adm-origin .adm-toolbar > .btn { min-height: 36px; }
+body.admin-workspace .adm-origin-summary { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; padding: 15px 0; border-top: 1px solid var(--border); }
+body.admin-workspace .adm-origin-summary > strong { font-size: 26px; line-height: 1.2; font-weight: 650; color: #253b33; }
+body.admin-workspace .adm-origin-summary > span { font-size: 13px; color: #53656d; }
+body.admin-workspace .adm-origin-summary > small { margin-left: auto; font-size: 11px; color: #65717c; }
+body.admin-workspace .adm-origin-method { font-size: 12px; color: #65717c; margin: -6px 0 2px; }
+body.admin-workspace .adm-origin-method summary { cursor: pointer; width: fit-content; padding: 2px 0; }
+body.admin-workspace .adm-origin-method .adm-origin__note { padding: 12px 0 4px; max-width: 1000px; }
+body.admin-workspace .adm-origin-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; align-items: start; }
+body.admin-workspace .adm-origin-grid .adm-card { min-height: 178px; }
+body.admin-workspace .adm-origin-grid .adm-card__head { min-height: 76px; }
+body.admin-workspace .adm-origin__empty { display: flex; flex-direction: column; gap: 5px; min-height: 100px; justify-content: center; }
+body.admin-workspace .adm-origin__empty span:first-child { color: #4e626a; font-size: 13px; font-weight: 500; }
+body.admin-workspace .adm-origin__empty span:last-child { color: #6b7780; font-size: 12px; }
+@media (max-width: 1200px) {
+    body.admin-workspace .adm-origin .adm-toolbar { grid-template-columns: minmax(180px, 1.5fr) repeat(2, minmax(120px, 1fr)); }
+    body.admin-workspace .adm-origin .adm-toolbar > .btn, body.admin-workspace .adm-origin .adm-toolbar > .adm-icon-btn { justify-self: start; }
+    body.admin-workspace .adm-kpi--link { padding: 15px 12px; }
+}
+@media (max-width: 700px) {
+    body.admin-workspace .adm-origin-grid { grid-template-columns: minmax(0, 1fr); }
+    body.admin-workspace .adm-origin .adm-toolbar { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+    body.admin-workspace .adm-origin .adm-toolbar label:first-child { grid-column: 1 / -1; }
+    body.admin-workspace .adm-origin-summary > small { flex-basis: 100%; margin-left: 0; }
+    body.admin-workspace .adm-listing-tools .adm-listing-search { flex-basis: 100%; }
+    body.admin-workspace .adm-listing-tabs { gap: 18px; }
+    body.admin-workspace .stat-cards { grid-template-columns: repeat(auto-fit, minmax(min(100%, 150px), 1fr)); }
+    body.admin-workspace .adm-actions .adm-icon-btn { width: 40px; height: 40px; min-width: 40px; }
+    body.admin-workspace .adm-col-actions { width: 104px; }
+}
+@media (prefers-reduced-motion: reduce) {
+    body.admin-workspace .adm-kpi--link { transition: none; }
+}
