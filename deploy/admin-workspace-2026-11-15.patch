+/* Scoped operational design system; public and establishment pages retain their styles. */
+body.admin-workspace {
+    --primary: #146b55;
+    --primary-dark: #164d40;
+    --primary-light: #eaf4ef;
+    --ink: #202b33;
+    --muted: #65717c;
+    --border: #e1e6eb;
+    --bg: #f5f6f8;
+    --white: #fff;
+    --danger: #b54747;
+    --field-radius: 6px;
+    --field-size: 13px;
+    margin: 0;
+    min-width: 0;
+    width: 100%;
+    height: auto;
+    min-height: 100dvh;
+    overflow: visible;
+    display: block;
+    background: var(--bg);
+    color: var(--ink);
+    font: 14px/1.5 -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
+}
+body.admin-workspace *, body.admin-workspace *::before, body.admin-workspace *::after { box-sizing: border-box; letter-spacing: 0; }
+body.admin-workspace h1, body.admin-workspace h2, body.admin-workspace h3,
+body.admin-workspace input, body.admin-workspace select, body.admin-workspace button, body.admin-workspace textarea { font-family: inherit; }
+body.admin-workspace a { text-underline-offset: 3px; }
+body.admin-workspace a:focus-visible, body.admin-workspace button:focus-visible,
+body.admin-workspace input:focus-visible, body.admin-workspace select:focus-visible,
+body.admin-workspace summary:focus-visible { outline: 2px solid #397ea1; outline-offset: 3px; }
+body.admin-workspace [hidden] { display: none !important; }
+
+/* One page scroll, with navigation that stays in reach. */
+body.admin-workspace .adm-top {
+    position: sticky;
+    top: 0;
+    z-index: 100;
+    display: grid;
+    grid-template-columns: 224px minmax(180px, 440px) minmax(0, 1fr);
+    align-items: center;
+    gap: 24px;
+    min-height: 64px;
+    height: 64px;
+    padding: 0 24px 0 16px;
+    background: #fff;
+    border-bottom: 1px solid var(--border);
+    box-shadow: none;
+}
+body.admin-workspace .adm-top__left { min-width: 0; gap: 10px; }
+body.admin-workspace .adm-brand { display: inline-flex; align-items: center; gap: 9px; font-size: 17px; font-weight: 650; color: #253c35; white-space: nowrap; }
+body.admin-workspace .adm-brand b { color: #b45437; font-weight: 650; }
+body.admin-workspace .adm-brand .adm-brand__mark { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 8px; background: #eaf4ef; color: var(--primary); }
+body.admin-workspace .adm-brand__mark svg { width: 19px; height: 19px; }
+body.admin-workspace .adm-brand .adm-brand__text { display: block; padding: 0; margin: 0; background: none; font: inherit; color: inherit; }
+body.admin-workspace .adm-brand small { display: block; color: var(--muted); font-size: 10px; font-weight: 500; line-height: 1.3; }
+body.admin-workspace .adm-env { display: inline-flex; gap: 4px; padding: 3px 0; background: none; color: #617369; font-size: 10px; font-weight: 600; }
+body.admin-workspace .adm-env i { width: 5px; height: 5px; background: #238363; }
+body.admin-workspace .adm-search { width: 100%; min-width: 0; max-width: none; }
+body.admin-workspace .adm-search input { height: 36px; padding: 0 60px 0 34px; background: #f6f7f9; border: 1px solid #e7ebee; border-radius: 6px; font-size: 13px; }
+body.admin-workspace .adm-search__kbd { border: 1px solid var(--border); background: #fff; color: #74808a; border-radius: 4px; padding: 1px 5px; font-size: 10px; }
+body.admin-workspace .adm-top__right { min-width: 0; justify-content: flex-end; gap: 12px; }
+body.admin-workspace .adm-icon-btn { width: 34px; height: 34px; min-width: 34px; border: 1px solid var(--border); border-radius: 6px; background: #fff; color: #66737b; }
+body.admin-workspace .adm-icon-btn svg { width: 17px; height: 17px; }
+body.admin-workspace .adm-badge { min-width: 15px; height: 15px; top: -5px; right: -4px; font-size: 9px; background: #b34e42; }
+body.admin-workspace .adm-who { gap: 8px; padding: 0; min-width: 0; }
+body.admin-workspace .adm-avatar { width: 32px; height: 32px; background: #e9eef5; color: #435875; font-size: 11px; }
+body.admin-workspace .adm-who__t { max-width: 160px; min-width: 0; }
+body.admin-workspace .adm-who__t strong { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 12px; font-weight: 600; }
+body.admin-workspace .adm-who__t small { font-size: 10px; color: var(--muted); }
+body.admin-workspace .adm-pop { border: 1px solid var(--border); border-radius: 8px; box-shadow: 0 12px 36px #192b391a; max-height: min(70dvh, 520px); overflow-y: auto; }
+body.admin-workspace .adm-pop a, body.admin-workspace .adm-pop button { font-size: 13px; }
+
+body.admin-workspace .admin-shell { display: grid; grid-template-columns: 224px minmax(0, 1fr); min-height: calc(100dvh - 64px); align-items: start; }
+body.admin-workspace .admin-sidebar {
+    position: sticky; top: 64px; width: 224px; height: calc(100dvh - 64px); min-height: 0;
+    padding: 14px 12px; margin: 0; border: 0; border-right: 1px solid var(--border);
+    border-radius: 0; background: #fff; box-shadow: none; overflow-y: auto; overscroll-behavior: contain; scrollbar-width: thin;
+}
+body.admin-workspace .admin-sidebar__context { display: flex; align-items: center; gap: 7px; padding: 0 10px 12px; color: #75808a; font-size: 11px; font-weight: 600; }
+body.admin-workspace .admin-sidebar__dot { width: 6px; height: 6px; border-radius: 50%; background: #3e8b71; }
+body.admin-workspace .admin-sidebar .group-label { margin: 0; padding: 12px 10px 5px; font-size: 10px; font-weight: 600; color: #66737d; text-transform: uppercase; }
+body.admin-workspace .admin-sidebar a {
+    display: flex; align-items: center; gap: 9px; height: auto; min-height: 33px; margin: 2px 0; padding: 6px 10px;
+    border-radius: 5px; color: #596671; font-size: 12px; font-weight: 500; line-height: 1.4; text-decoration: none; box-shadow: none;
+}
+body.admin-workspace .admin-sidebar a > span { min-width: 0; overflow-wrap: anywhere; }
+body.admin-workspace .admin-sidebar a svg { flex: none; width: 16px; height: 16px; stroke-width: 1.7; color: #7e8992; }
+body.admin-workspace .admin-sidebar a:hover { background: #f5f6f8; color: #253b34; }
+body.admin-workspace .admin-sidebar a.active { background: #eaf4ef; color: #146b55; font-weight: 650; box-shadow: none; }
+body.admin-workspace .admin-sidebar a.active svg { color: #146b55; }
+body.admin-workspace .admin-sidebar .adm-nb { height: 17px; min-width: 17px; padding: 0 4px; font-size: 9px; background: #f5e8dd; color: #96652b; }
+body.admin-workspace .admin-sidebar .admin-sidebar__public { margin-top: 18px; padding-top: 12px; border-top: 1px solid var(--border); border-radius: 0; font-size: 11px; }
+body.admin-workspace .admin-main { width: auto; min-width: 0; height: auto; overflow: visible; padding: 26px 30px 40px; }
+body.admin-workspace .admin-main > .container { width: 100%; min-width: 0; margin: 0; }
+body.admin-workspace .admin-main:focus { outline: none; }
